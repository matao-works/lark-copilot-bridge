{
  "name": "lark-copilot-bridge",
  "version": "0.1.5",
  "description": "在飞书里和本地 GitHub Copilot CLI 对话",
  "type": "module",
  "bin": {
    "lark-copilot-bridge": "dist/lark-copilot-bridge.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/lark-copilot-bridge.js",
    "dev": "node --import tsx bin/lark-copilot-bridge.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matao-works/lark-copilot-bridge.git"
  },
  "homepage": "https://github.com/matao-works/lark-copilot-bridge#readme",
  "bugs": {
    "url": "https://github.com/matao-works/lark-copilot-bridge/issues"
  },
  "keywords": [
    "feishu",
    "lark",
    "copilot",
    "github-copilot",
    "bridge",
    "chatbot"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "dependencies": {
    "@larksuite/channel": "^0.4.0",
    "@larksuiteoapi/node-sdk": "^1.71.1",
    "dotenv": "^16.4.5",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
