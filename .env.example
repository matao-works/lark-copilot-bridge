# 可选配置文件（大多数情况不用手改）
# 推荐直接运行：lark-copilot-bridge setup
#
# 路径：~/.lark-copilot-bridge/.env
# 查看当前设置：lark-copilot-bridge config
# 环境自检：lark-copilot-bridge doctor

# 飞书凭证无需填写，首次运行扫码即可

# 谁能用：用户编号，逗号分隔（对方发 /whoami 可查看）
# 留空 = 不限制（有风险）。更推荐用 setup 选「仅我自己」
LARK_ALLOWED_USERS=

# 项目文件夹（Copilot 只能动这里的文件）
COPILOT_CWD=

# 追加 copilot 参数，例如 --model gpt-5
COPILOT_EXTRA_ARGS=

# 单次任务超时（毫秒），默认 300000（5 分钟）
COPILOT_TIMEOUT=300000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
