# 可选配置文件
# 推荐路径：~/.lark-copilot-bridge/.env
# （全局安装后任意目录运行都会读取；当前目录 .env 可覆盖）

# 飞书凭证无需填写，首次运行扫码自动创建并保存到 ~/.lark-copilot-bridge/config.json

# 限定可使用机器人的用户 open_id（逗号分隔），留空 = 不限制
LARK_ALLOWED_USERS=

# Copilot 工作目录（默认 process.cwd()，建议设为常用项目路径）
COPILOT_CWD=

# 追加 copilot 参数，例如 --model gpt-5
COPILOT_EXTRA_ARGS=

# 单次任务超时（毫秒），默认 300000（5 分钟）
COPILOT_TIMEOUT=300000

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
