# lark-copilot-bridge 配置
#
# 飞书应用凭证不需要手动填！
# 首次运行 npm start 时会自动调用 lark-cli 扫码绑定，浏览器完成即可。

# 可选：限定允许使用机器人的飞书用户 open_id（逗号分隔），留空=允许所有人
# open_id 在机器人收到消息时的日志里能看到
LARK_ALLOWED_USERS=

# Copilot 工作目录（copilot 子进程的 cwd，必须具体到项目目录）
COPILOT_CWD=

# 可选：追加 copilot 参数，例如 --model gpt-5
COPILOT_EXTRA_ARGS=

# 可选：单次超时（毫秒），默认 5 分钟
COPILOT_TIMEOUT=300000

# 可选：日志级别 debug/info/warn/error
LOG_LEVEL=info
